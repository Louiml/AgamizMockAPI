{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agamiz Mock API",
  "version": "0.1.0",
  "identifier": "app.agamiz.mockapi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agamiz Mock API",
        "width": 1380,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#07130D",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Sleek desktop mock server for API prototyping.",
    "longDescription": "Agamiz Mock API is a local mock server & API prototyping tool for frontend and mobile engineers.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}